# ===== 城市与时区 =====
CITY_A=Ann Arbor
CITY_A_TZ=America/Detroit
CITY_B=Shanghai
CITY_B_TZ=Asia/Shanghai

# ===== 日期 =====
# 可选的约数起点（不是已核实的相识日）；缺失时默认 2019-09-02
KNOWN_START_DATE=2019-09-02
# 运行必填：在一起起始日 YYYY-MM-DD
LOVE_START_DATE=2026-07-08
# 运行必填：下次见面日 YYYY-MM-DD
NEXT_MEET_DATE=2026-12-20

# ===== QWeather（可选；缺少 Key/Host 时使用免密钥 Open-Meteo）=====
# QWEATHER_KEY=your_qweather_key
# QWEATHER_API_HOST=https://your-account-host.qweatherapi.com

# ===== Gemini（可选；英文生成失败则用内置英文短句）=====
# 真实 Key 只存 GitHub Actions Secret GEMINI_API_KEY；请求时经 x-goog-api-key 头传递
# 不要将真实 Key 写入本地 .env、仓库或聊天；暴露过的 Key 应私下撤销并替换
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL 为可选覆盖；未设置时使用代码中固定默认的 gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash

# ===== 微信测试号（仅受控 GitHub Actions 真发；各 job 只加载自己的 OpenID）=====
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret
WECHAT_TEMPLATE_ID=your_template_id
WECHAT_OPENID_SELF=openid_for_self_us_slot
WECHAT_OPENID_CN=openid_for_cn_slot
# 真实值只保存在 GitHub Secrets，不能放入本地 .env

# ===== 运行控制 =====
# PUSH_SLOT=cn 或 us；默认示例为 Shanghai 对应的 cn
PUSH_SLOT=cn
# SEND_MODE 只能是 dry-run 或 live；缺失时也默认 dry-run
# live 必须匹配受控 Actions 的 live-self + us + SEND_SELF_ONCE，
# 或 live-cn + cn + SEND_CN_ONCE，并分别指定 LIVE_RECIPIENT=self/cn
# 不要在本地放真实微信凭据；所有 schedule 仍只预览
# 旧 DRY_RUN 即使缺失或为 0，也不会触发真实发送
SEND_MODE=dry-run
