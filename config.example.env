# ===== 城市与时区 =====
CITY_A=Ann Arbor
CITY_A_TZ=America/Detroit
CITY_B=Shanghai
CITY_B_TZ=Asia/Shanghai

# ===== 日期 =====
# 运行必填：在一起起始日 YYYY-MM-DD
LOVE_START_DATE=2024-01-01
# 运行必填：下次见面日 YYYY-MM-DD
NEXT_MEET_DATE=2026-12-25

# ===== QWeather（可选；Key 与账号专属 API Host 必须成对提供）=====
QWEATHER_KEY=your_qweather_key
QWEATHER_API_HOST=https://your-account-host.qweatherapi.com

# ===== Gemini（生成中文情话，失败则用内置列表）=====
GEMINI_API_KEY=your_gemini_api_key
# 可选模型，默认 gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# ===== 微信测试号（仅阶段 C 的 CN 真发必填）=====
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret
WECHAT_TEMPLATE_ID=your_template_id
WECHAT_OPENID_CN=openid_for_cn_slot
# 阶段 C 的 US 永远 dry-run，暂不需要 WECHAT_OPENID_US

# ===== 运行控制 =====
# PUSH_SLOT=cn 或 us；默认示例为 Shanghai 对应的 cn
PUSH_SLOT=cn
# SEND_MODE 只能是 dry-run 或 live；缺失时也默认 dry-run
# live 还必须匹配受控 GitHub Actions 的 live-cn 上下文；不要在本地放真实微信凭据
# 旧 DRY_RUN 即使缺失或为 0，也不会触发真实发送
SEND_MODE=dry-run
