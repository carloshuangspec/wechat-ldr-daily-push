# ===== 城市与时区 =====
CITY_A=Ann Arbor
CITY_A_TZ=America/Detroit
CITY_B=Shanghai
CITY_B_TZ=Asia/Shanghai

# ===== 日期 =====
# 在一起起始日 YYYY-MM-DD
LOVE_START_DATE=2024-01-01
# 下次见面日 YYYY-MM-DD（已过则为 0）
NEXT_MEET_DATE=2026-12-25

# ===== 和风天气 QWeather =====
QWEATHER_KEY=your_qweather_key
# 可选：默认 https://devapi.qweather.com ；商业版填自定义 host，如 https://api.qweather.com
# QWEATHER_API_HOST=https://devapi.qweather.com

# ===== Gemini（生成中文情话，失败则用内置列表）=====
GEMINI_API_KEY=your_gemini_api_key
# 可选模型，默认 gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# ===== 微信测试号 =====
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret
WECHAT_TEMPLATE_ID=your_template_id
# 本地单次推送可用 WECHAT_OPENID；Actions 用 PUSH_SLOT=cn|us 选对应 openid
WECHAT_OPENID=your_openid
# WECHAT_OPENID_CN=openid_for_cn_slot
# WECHAT_OPENID_US=openid_for_us_slot

# ===== 运行控制 =====
# PUSH_SLOT=cn 或 us（GitHub Actions 两个 job 分别设置）
# DRY_RUN=1 只打印 JSON，不真正发送
DRY_RUN=1
